cable 60.000,41.048 57.958,44.488 6 12 0.0005067 10 con

; 5
cable 61.406,41.646 60.347,45.503 6 12 0.0005067 10 con

; 6
cable 62.920,41.850 62.920,45.850 6 12 0.0005067 10 con

; 7
cable 64.433,41.646 65.492,45.503 6 12 0.0005067 10 con

; 8
cable 65.839,41.048 67.881,44.488 6 12 0.0005067 10 con

; 9
cable 67.037,40.100 69.916,42.877 6 12 0.0005067 10 con

