re 01.sav

;록볼트물성치
;prop mat 물성번호 cb_de 단위중량 cb_yi 항복강도 cb_yc comp yield force cb_ym 탄성계수
;prop mat 물성번호 cb_kb shear stiffness cb_sb shear strength
prop mat 12 &
		cb_de	7.85E-03					&
		cb_ym	210000 					&
		cb_kbond	0.75E+04					&
		cb_sbond	0.4 					&
		cb_yield	490

;소프트숏크리트물성치
;prop mat 물성번호 st_d 단위중량 st_p 프아송비 st_ym 탄성계수
;prop mat 물성번호 interface 물성치
prop mat 13 &
	st_d	2.5E-03			&
	st_p	0.20 			&
	st_ym	5.00E+03			&
	if_kn	4.46E+03			&
	if_ks	2.23E+03			&
	if_c	1.00 			&
	if_fr	45 			&
	if_t	1.00
; 출처(숏크리트 라이닝의 거동해석에 영향을 미치는 입력변수들에 대한 민감도분석(배두진, 이두화, 장수호, 김영근)

; interface의 파괴 유무 확인 명령어는 pl bound stru ifail 임

;숏크리트설치
;xc yc 중심좌표 np 절점갯수 thi 두께 mat 물성번호
;fang 시점각도 the 종점각도-시점각도
struct gen xc 62.9200 yc 36.1300 np 80 thi 0.12 mat 13 fang 0.01 theta 180 ;

; Pl bl stru thick red 명령으로 Shotcrete 생성 확인
; Pl stru num 명령으로 확인

