cable 68.487,37.442 72.380,38.360 6 12 0.0005067 10 con



; Pl bl bou stru ca 명령으로 R/B 생성 확인

def setVariable
    xCoord=62.9200
    yCoord=36.1300
    relax=0.70 ; 상반 54:16:50 = 0.54:0.70:1.0
    tunnelNumber = 1
    stageNumber = 2
end

setVariable

findDomain

getfor

appfor

step 5000

save 02.sav
